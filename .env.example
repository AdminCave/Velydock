# Velydock configuration. Copy to .env – or run ./scripts/install.sh, which also generates
# all secrets.

# --- Addresses -----------------------------------------------------------------------------------
# Three host names that point to this server. Use names under the same domain as the apps you
# want to embed, otherwise browsers treat their cookies as third-party (see docs/app-integration.md).
VELYDOCK_HOST=dock.example.com
KEYCLOAK_HOST=auth.example.com
SANDBOX_HOST=sandbox.example.com

# E-mail address for Let's Encrypt (expiry notices).
ACME_EMAIL=admin@example.com

# --- Reverse proxy -------------------------------------------------------------------------------
# "proxy" starts the bundled Traefik. Remove it to use your own reverse proxy.
COMPOSE_PROFILES=proxy
# HTTP_BIND=0.0.0.0:80
# HTTPS_BIND=0.0.0.0:443

# --- Version -------------------------------------------------------------------------------------
VELYDOCK_IMAGE=ghcr.io/admincave/velydock:latest

# --- Secrets (generate each with: openssl rand -hex 32) ------------------------------------------
POSTGRES_PASSWORD=
VELYDOCK_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
VELYDOCK_SECRET_KEY=
VELYDOCK_OIDC_CLIENT_SECRET=
VELYDOCK_IDP_ADMIN_CLIENT_SECRET=
# Only needed for the very first start (Velydock creates its Keycloak realm with it).
KEYCLOAK_BOOTSTRAP_SECRET=

# --- Options -------------------------------------------------------------------------------------
# Administrators must set up a second factor (authenticator app) at sign-in.
VELYDOCK_REQUIRE_ADMIN_2FA=true
# Sessions end after this idle time and at the latest after the maximum lifetime.
VELYDOCK_SESSION_IDLE_MINUTES=120
VELYDOCK_SESSION_MAX_HOURS=12
# The embeddability check fetches the app's address from the server. Private addresses are
# refused unless you enable this (only do so if you trust your organization administrators).
VELYDOCK_EMBED_CHECK_ALLOW_PRIVATE=false
