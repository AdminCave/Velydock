# Development and test settings. NOT for production: these secrets are public.
# *.localhost resolves to 127.0.0.1 in browsers without any DNS setup.

COMPOSE_PROFILES=proxy

VELYDOCK_HOST=dock.velydock.localhost
KEYCLOAK_HOST=auth.velydock.localhost
SANDBOX_HOST=sandbox.velydock.localhost
PUBLIC_PORT_SUFFIX=:8443
DEV_HTTPS_PORT=8443
TLS_RESOLVER=

POSTGRES_PASSWORD=dev-postgres-password
VELYDOCK_DB_PASSWORD=dev-velydock-db-password
KEYCLOAK_DB_PASSWORD=dev-keycloak-db-password
KEYCLOAK_BOOTSTRAP_SECRET=dev-keycloak-bootstrap-secret
VELYDOCK_SECRET_KEY=dev-secret-key-0123456789abcdef0123456789abcdef
VELYDOCK_OIDC_CLIENT_SECRET=dev-oidc-client-secret-0123456789
VELYDOCK_IDP_ADMIN_CLIENT_SECRET=dev-idp-admin-secret-0123456789

# Browser tests sign in as administrators; enrolling a second factor is covered separately.
VELYDOCK_REQUIRE_ADMIN_2FA=false
VELYDOCK_LOG_LEVEL=INFO
